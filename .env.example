# Database
DATABASE_URL=postgres://postgres:mysecretpassword@localhost:5432/open-health
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_USER=postgres
POSTGRES_DB=open-health

# Web
NEXT_PUBLIC_URL=http://localhost:3000

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=http://localhost:3000

# Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Analytics
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# Deployment Environment (local, cloud)
DEPLOYMENT_ENV=local
NEXT_PUBLIC_DEPLOYMENT_ENV=local

# Redis cache layer
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_KEY_PREFIX=open-health:
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES=10

# Logging
LOG_LEVEL=info

# API Keys for cloud deployment
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
UPSTAGE_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Trigger.dev for cloud deployment
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=

# Langsmith
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Reddit Application
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_ADMIN_USERNAME=
REDDIT_ADMIN_PASSWORD=
REDDIT_SUBREDDIT=
